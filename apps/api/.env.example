# Salin ke .env lalu sesuaikan.
# Docker (docker compose up -d di root repo) memakai port 5433:
DATABASE_URL="postgresql://hris:hris_dev_password@localhost:5433/hris?schema=public"

PORT=3100
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Rahasia JWT — minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_MFA_SECRET=dev-only-mfa-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Kunci enkripsi kolom (AES-256-GCM) dan HMAC pencarian, masing-masing 32 byte base64.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Format ENCRYPTION_KEYS: "<versi>:<kunci>,<versi>:<kunci>" — versi pertama dipakai untuk enkripsi baru.
ENCRYPTION_KEYS="v1:ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM="
HMAC_KEY="ZGV2LW9ubHktaG1hYy1rZXktZm9yLWxvb2t1cHMtMzI="

# Password akun demo yang dibuat oleh seed (hanya untuk development).
SEED_DEFAULT_PASSWORD="Demo-Hris-2026!"
