// Skema Fase 1 — Auth & RBAC, Organisasi, Employee, Komponen Gaji, Audit.
// Acuan: ERD-Sistem-HRIS.md v1.1. Kolom yang diakhiri "Encrypted" berisi ciphertext
// AES-256-GCM (lihat src/common/crypto), sehingga bertipe TEXT, bukan DECIMAL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum WorkPattern {
  FIVE_DAY @map("5_day")
  SIX_DAY  @map("6_day")
}

enum ProrataMethod {
  working_days
  calendar_days
}

enum RoundingMode {
  round_half_up
  floor
  ceil
}

enum Gender {
  male
  female
}

enum EmploymentStatus {
  active
  resigned
  terminated
}

enum ContractType {
  permanent
  contract
  intern
  probation
}

enum SalaryComponentType {
  earning
  deduction
}

enum SalaryComponentCalculation {
  fixed_amount
  per_attendance_day
}

enum AuditAction {
  create
  update
  delete
  view_sensitive
  export
  login
}

enum AttendanceStatus {
  present
  late
  absent
  on_leave
  half_day_leave
  sick
  permit
  holiday
  day_off
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum HolidayType {
  national
  collective_leave
  company
}

enum ApprovalRequestType {
  leave
  reimbursement
  payroll
  attendance_correction
  overtime
}

enum ApproverType {
  direct_supervisor
  department_head
  role
}

enum ApprovalAction {
  approved
  rejected
  escalated
}

enum OvertimeDayType {
  workday
  rest_day
  holiday
  holiday_shortest_day
}

enum BpjsProgram {
  kesehatan
  jht
  jkk
  jkm
  jp
}

enum PayrollRunType {
  regular
  thr
  bonus
  correction
  final_settlement
}

enum PayrollPeriodStatus {
  draft
  pending_approval
  approved
  locked
}

enum Pph21Method {
  ter
  annual_reconciliation
}

enum PayrollComponentKind {
  earning
  deduction
  company_contribution
  taxable_benefit
}

enum ReimbursementCategory {
  transport
  medical
  meal
  office_supply
  travel
  other
}

// ───────────────────────────── Auth & RBAC ─────────────────────────────

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  mfaSecretEncrypted  String?   @map("mfa_secret_encrypted")
  mfaPendingEncrypted String?   @map("mfa_pending_encrypted")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee            Employee?
  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  approvalLogs        ApprovalLog[]        @relation("ApprovalActor")
  delegatedLogs       ApprovalLog[]        @relation("ApprovalBehalfOf")
  delegationsGiven    ApprovalDelegation[] @relation("Delegator")
  delegationsReceived ApprovalDelegation[] @relation("Delegate")
  notifications       Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid // null = role bawaan sistem
  name        String   @db.VarChar(50)
  description String?
  requiresMfa Boolean  @default(false) @map("requires_mfa")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company         Company?         @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  approverSteps   ApprovalStep[]   @relation("StepApproverRole")
  fallbackSteps   ApprovalStep[]   @relation("StepFallbackRole")

  // UNIQUE (company_id, name) NULLS NOT DISTINCT dibuat di migrasi SQL
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@id([userId, roleId, companyId])
  @@index([userId, companyId])
  @@map("user_roles")
}

/// Refresh token disimpan sebagai hash SHA-256. family_id mengelompokkan rantai rotasi;
/// pemakaian ulang token yang sudah dirotasi mencabut seluruh family (reuse detection).
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

// ───────────────────────────── Organisasi ─────────────────────────────

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  npwp      String?  @db.VarChar(30)
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings          CompanySettings?
  departments       Department[]
  workLocations     WorkLocation[]
  employees         Employee[]
  roles             Role[]
  userRoles         UserRole[]
  salaryComponents  SalaryComponent[]
  shifts            Shift[]
  holidays          Holiday[]
  leaveTypes        LeaveType[]
  approvalWorkflows ApprovalWorkflow[]
  payrollPeriods    PayrollPeriod[]
  reimbursements    Reimbursement[]

  @@map("companies")
}

model CompanySettings {
  companyId                    String        @id @map("company_id") @db.Uuid
  riskClassJkk                 String        @default("I") @map("risk_class_jkk") @db.VarChar(5)
  defaultWorkPattern           WorkPattern   @default(FIVE_DAY) @map("default_work_pattern")
  prorataMethod                ProrataMethod @default(working_days) @map("prorata_method")
  roundingMode                 RoundingMode  @default(round_half_up) @map("rounding_mode")
  minimumWage                  Decimal       @default(0) @map("minimum_wage") @db.Decimal(15, 0)
  maxDeductionPct              Decimal       @default(0.5) @map("max_deduction_pct") @db.Decimal(6, 5)
  payrollCutoffDay             Int           @default(31) @map("payroll_cutoff_day")
  payDay                       Int           @default(25) @map("pay_day")
  annualLeaveEligibilityMonths Int           @default(12) @map("annual_leave_eligibility_months")
  annualLeaveProrata           Boolean       @default(false) @map("annual_leave_prorata")
  attendancePhotoRetentionDays Int           @default(180) @map("attendance_photo_retention_days")
  updatedAt                    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  name               String   @db.VarChar(100)
  parentDepartmentId String?  @map("parent_department_id") @db.Uuid
  headEmployeeId     String?  @map("head_employee_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company      @relation(fields: [companyId], references: [id])
  parent    Department?  @relation("DepartmentTree", fields: [parentDepartmentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  head      Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  positions Position[]
  employees Employee[]   @relation("EmployeeDepartment")

  // UNIQUE (company_id, parent_department_id, name) NULLS NOT DISTINCT dibuat di migrasi SQL
  @@index([companyId])
  @@map("departments")
}

model Position {
  id               String   @id @default(uuid()) @db.Uuid
  departmentId     String   @map("department_id") @db.Uuid
  title            String   @db.VarChar(100)
  level            Int      @default(1)
  overtimeEligible Boolean  @default(true) @map("overtime_eligible")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([departmentId, title])
  @@map("positions")
}

/// Geofence absensi. Fase 1 memakai lat/lng + haversine di aplikasi (tanpa PostGIS);
/// bisa dimigrasikan ke GEOGRAPHY(POINT) bila nanti butuh query spasial.
model WorkLocation {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String   @db.VarChar(100)
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  radiusMeters Int      @map("radius_meters")
  timezone     String   @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, name])
  @@map("work_locations")
}

// ───────────────────────────── Employee ─────────────────────────────

model Employee {
  id                       String           @id @default(uuid()) @db.Uuid
  userId                   String?          @unique @map("user_id") @db.Uuid
  companyId                String           @map("company_id") @db.Uuid
  departmentId             String           @map("department_id") @db.Uuid
  positionId               String           @map("position_id") @db.Uuid
  supervisorId             String?          @map("supervisor_id") @db.Uuid
  workLocationId           String?          @map("work_location_id") @db.Uuid
  nikEncrypted             String           @map("nik_encrypted")
  nikHash                  String           @map("nik_hash") @db.VarChar(64)
  employeeCode             String           @map("employee_code") @db.VarChar(20)
  fullName                 String           @map("full_name") @db.VarChar(255)
  gender                   Gender
  religion                 String?          @db.VarChar(30)
  birthDate                DateTime         @map("birth_date") @db.Date
  joinDate                 DateTime         @map("join_date") @db.Date
  probationEndDate         DateTime?        @map("probation_end_date") @db.Date
  contractEndDate          DateTime?        @map("contract_end_date") @db.Date
  resignDate               DateTime?        @map("resign_date") @db.Date
  employmentStatus         EmploymentStatus @default(active) @map("employment_status")
  contractType             ContractType     @map("contract_type")
  workPattern              WorkPattern?     @map("work_pattern")
  overtimeEligible         Boolean?         @map("overtime_eligible")
  ptkpStatus               String           @map("ptkp_status") @db.VarChar(5)
  baseSalaryEncrypted      String           @map("base_salary_encrypted")
  bankAccountEncrypted     String?          @map("bank_account_encrypted")
  bankName                 String?          @map("bank_name") @db.VarChar(100)
  npwpEncrypted            String?          @map("npwp_encrypted")
  bpjsKesehatanNumber      String?          @map("bpjs_kesehatan_number") @db.VarChar(30)
  bpjsTkNumber             String?          @map("bpjs_tk_number") @db.VarChar(30)
  bpjsExtraFamilyMembers   Int              @default(0) @map("bpjs_extra_family_members")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User?                     @relation(fields: [userId], references: [id])
  company          Company                   @relation(fields: [companyId], references: [id])
  department       Department                @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  position         Position                  @relation(fields: [positionId], references: [id])
  supervisor       Employee?                 @relation("Supervision", fields: [supervisorId], references: [id])
  subordinates     Employee[]                @relation("Supervision")
  workLocation     WorkLocation?             @relation(fields: [workLocationId], references: [id])
  headOf                Department[]              @relation("DepartmentHead")
  history               EmployeeHistory[]
  salaryComponents      EmployeeSalaryComponent[]
  shiftSchedules        ShiftSchedule[]
  attendances           Attendance[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  overtimeEntries       OvertimeEntry[]
  payrollDetails        PayrollDetail[]
  taxYearSummaries      TaxYearSummary[]
  reimbursements        Reimbursement[]

  @@unique([companyId, nikHash])
  @@unique([companyId, employeeCode])
  @@index([companyId, employmentStatus])
  @@index([supervisorId])
  @@map("employees")
}

model EmployeeHistory {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  fieldChanged  String   @map("field_changed") @db.VarChar(50)
  oldValue      String?  @map("old_value") // dienkripsi untuk field sensitif
  newValue      String?  @map("new_value")
  isEncrypted   Boolean  @default(false) @map("is_encrypted")
  effectiveDate DateTime @map("effective_date") @db.Date
  reason        String?
  changedBy     String?  @map("changed_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, fieldChanged, effectiveDate])
  @@map("employee_history")
}

// ───────────────────────────── Komponen Gaji ─────────────────────────────

model SalaryComponent {
  id          String                     @id @default(uuid()) @db.Uuid
  companyId   String                     @map("company_id") @db.Uuid
  code        String                     @db.VarChar(30)
  name        String                     @db.VarChar(100)
  type        SalaryComponentType
  isFixed     Boolean                    @map("is_fixed")
  calculation SalaryComponentCalculation @default(fixed_amount)
  isTaxable   Boolean                    @default(true) @map("is_taxable")
  isActive    Boolean                    @default(true) @map("is_active")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company                   @relation(fields: [companyId], references: [id])
  assigned  EmployeeSalaryComponent[]

  @@unique([companyId, code])
  @@map("salary_components")
}

model EmployeeSalaryComponent {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  componentId     String    @map("component_id") @db.Uuid
  amountEncrypted String    @map("amount_encrypted")
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee        @relation(fields: [employeeId], references: [id])
  component SalaryComponent @relation(fields: [componentId], references: [id])

  @@index([employeeId, componentId, effectiveFrom])
  @@map("employee_salary_components")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only (trigger di migrasi menolak UPDATE/DELETE/TRUNCATE).
/// row_hash = sha256(prev_hash || isi baris) → rantai hash untuk deteksi manipulasi.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  companyId  String?     @map("company_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  tableName  String      @map("table_name") @db.VarChar(100)
  recordId   String      @map("record_id") @db.VarChar(64)
  action     AuditAction
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String?     @map("ip_address") @db.VarChar(64)
  userAgent  String?     @map("user_agent")
  prevHash   String?     @map("prev_hash") @db.VarChar(64)
  rowHash    String      @map("row_hash") @db.VarChar(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tableName, recordId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Approval Workflow (Fase 2) ─────────────────────────────

model ApprovalWorkflow {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  requestType ApprovalRequestType @map("request_type")
  name        String              @db.VarChar(100)
  version     Int                 @default(1)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company               Company                @relation(fields: [companyId], references: [id])
  steps                 ApprovalStep[]
  leaveRequests         LeaveRequest[]
  attendanceCorrections AttendanceCorrection[]
  overtimeEntries       OvertimeEntry[]
  reimbursements        Reimbursement[]

  @@unique([companyId, requestType, version])
  @@index([companyId, requestType, isActive])
  @@map("approval_workflows")
}

model ApprovalStep {
  id                 String       @id @default(uuid()) @db.Uuid
  workflowId         String       @map("workflow_id") @db.Uuid
  stepOrder          Int          @map("step_order")
  approverType       ApproverType @map("approver_type")
  approverRoleId     String?      @map("approver_role_id") @db.Uuid
  fallbackRoleId     String?      @map("fallback_role_id") @db.Uuid
  escalateAfterHours Int?         @map("escalate_after_hours")

  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverRole Role?            @relation("StepApproverRole", fields: [approverRoleId], references: [id])
  fallbackRole Role?            @relation("StepFallbackRole", fields: [fallbackRoleId], references: [id])
  logs         ApprovalLog[]

  @@unique([workflowId, stepOrder])
  @@map("approval_steps")
}

model ApprovalLog {
  id          String              @id @default(uuid()) @db.Uuid
  requestType ApprovalRequestType @map("request_type")
  requestId   String              @map("request_id") @db.Uuid
  stepId      String              @map("step_id") @db.Uuid
  approverId  String              @map("approver_id") @db.Uuid
  onBehalfOf  String?             @map("on_behalf_of") @db.Uuid
  action      ApprovalAction
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  step       ApprovalStep @relation(fields: [stepId], references: [id])
  approver   User         @relation("ApprovalActor", fields: [approverId], references: [id])
  behalfUser User?        @relation("ApprovalBehalfOf", fields: [onBehalfOf], references: [id])

  @@index([requestType, requestId])
  @@map("approval_logs")
}

model ApprovalDelegation {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  delegatorId  String   @map("delegator_id") @db.Uuid
  delegateId   String   @map("delegate_id") @db.Uuid
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  requestTypes String[] @default([]) @map("request_types")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delegator User @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate  User @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([companyId, delegatorId, startDate, endDate])
  @@map("approval_delegations")
}

// ───────────────────────────── Absensi (Fase 2) ─────────────────────────────

model Shift {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  name                 String   @db.VarChar(50)
  startTime            String   @map("start_time") @db.VarChar(5) // "HH:MM" jam lokal
  endTime              String   @map("end_time") @db.VarChar(5)   // "HH:MM" jam lokal
  isOvernight          Boolean  @default(false) @map("is_overnight")
  lateToleranceMinutes Int      @default(0) @map("late_tolerance_minutes")
  workHours            Decimal  @map("work_hours") @db.Decimal(4, 2)
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company         @relation(fields: [companyId], references: [id])
  schedules   ShiftSchedule[]
  attendances Attendance[]

  @@unique([companyId, name])
  @@map("shifts")
}

model ShiftSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  date       DateTime @db.Date
  shiftId    String?  @map("shift_id") @db.Uuid // null = hari istirahat (day_off)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@map("shift_schedules")
}

model Attendance {
  id                String           @id @default(uuid()) @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  shiftId           String?          @map("shift_id") @db.Uuid
  workDate          DateTime         @map("work_date") @db.Date
  clockInTime       DateTime?        @map("clock_in_time") @db.Timestamptz(6)
  clockOutTime      DateTime?        @map("clock_out_time") @db.Timestamptz(6)
  clockInLat        Decimal?         @map("clock_in_lat") @db.Decimal(9, 6)
  clockInLng        Decimal?         @map("clock_in_lng") @db.Decimal(9, 6)
  clockOutLat       Decimal?         @map("clock_out_lat") @db.Decimal(9, 6)
  clockOutLng       Decimal?         @map("clock_out_lng") @db.Decimal(9, 6)
  clockInDistanceM  Int?             @map("clock_in_distance_m")
  clockOutDistanceM Int?             @map("clock_out_distance_m")
  clockInPhotoKey   String?          @map("clock_in_photo_key") @db.VarChar(500)
  clockOutPhotoKey  String?          @map("clock_out_photo_key") @db.VarChar(500)
  deviceFingerprint String?          @map("device_fingerprint") @db.VarChar(255)
  ipAddress         String?          @map("ip_address") @db.VarChar(64)
  lateMinutes       Int              @default(0) @map("late_minutes")
  anomalyFlags      String[]         @default([]) @map("anomaly_flags")
  status            AttendanceStatus @default(present)
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee    Employee               @relation(fields: [employeeId], references: [id])
  shift       Shift?                 @relation(fields: [shiftId], references: [id])
  corrections AttendanceCorrection[]

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("attendance")
}

model AttendanceCorrection {
  id                  String        @id @default(uuid()) @db.Uuid
  attendanceId        String?       @map("attendance_id") @db.Uuid
  employeeId          String        @map("employee_id") @db.Uuid
  workDate            DateTime      @map("work_date") @db.Date
  requestedClockIn    DateTime?     @map("requested_clock_in") @db.Timestamptz(6)
  requestedClockOut   DateTime?     @map("requested_clock_out") @db.Timestamptz(6)
  reason              String
  workflowId          String        @map("workflow_id") @db.Uuid
  currentApprovalStep Int           @default(1) @map("current_approval_step")
  status              RequestStatus @default(pending)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  attendance Attendance?      @relation(fields: [attendanceId], references: [id])
  employee   Employee         @relation(fields: [employeeId], references: [id])
  workflow   ApprovalWorkflow @relation(fields: [workflowId], references: [id])

  @@index([employeeId, status])
  @@map("attendance_corrections")
}

model Holiday {
  id                 String      @id @default(uuid()) @db.Uuid
  companyId          String?     @map("company_id") @db.Uuid // null = libur nasional
  date               DateTime    @db.Date
  name               String      @db.VarChar(100)
  type               HolidayType @default(national)
  deductsAnnualLeave Boolean     @default(false) @map("deducts_annual_leave")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company? @relation(fields: [companyId], references: [id])

  // UNIQUE (company_id, date) NULLS NOT DISTINCT dibuat di migrasi SQL
  @@index([date])
  @@map("holidays")
}

// ───────────────────────────── Cuti & Izin (Fase 2) ─────────────────────────────

model LeaveType {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @map("company_id") @db.Uuid
  code                  String   @db.VarChar(30)
  name                  String   @db.VarChar(50)
  defaultQuotaDays      Decimal? @map("default_quota_days") @db.Decimal(5, 2)
  isPaid                Boolean  @default(true) @map("is_paid")
  requiresDocument      Boolean  @default(false) @map("requires_document")
  genderRestriction     Gender?  @map("gender_restriction")
  allowHalfDay          Boolean  @default(false) @map("allow_half_day")
  minServiceMonths      Int      @default(0) @map("min_service_months")
  maxCarryOverDays      Decimal  @default(0) @map("max_carry_over_days") @db.Decimal(5, 2)
  carryOverExpiryMonths Int?     @map("carry_over_expiry_months")
  countsWorkingDaysOnly Boolean  @default(true) @map("counts_working_days_only")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company        @relation(fields: [companyId], references: [id])
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id                   String    @id @default(uuid()) @db.Uuid
  employeeId           String    @map("employee_id") @db.Uuid
  leaveTypeId          String    @map("leave_type_id") @db.Uuid
  year                 Int
  quotaDays            Decimal   @map("quota_days") @db.Decimal(5, 2)
  carriedOverDays      Decimal   @default(0) @map("carried_over_days") @db.Decimal(5, 2)
  carriedOverExpiresAt DateTime? @map("carried_over_expires_at") @db.Date
  usedDays             Decimal   @default(0) @map("used_days") @db.Decimal(5, 2)
  version              Int       @default(0)
  adjustedBy           String?   @map("adjusted_by") @db.Uuid
  adjustmentReason     String?   @map("adjustment_reason")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                  String        @id @default(uuid()) @db.Uuid
  employeeId          String        @map("employee_id") @db.Uuid
  leaveTypeId         String        @map("leave_type_id") @db.Uuid
  workflowId          String        @map("workflow_id") @db.Uuid
  startDate           DateTime      @map("start_date") @db.Date
  endDate             DateTime      @map("end_date") @db.Date
  isHalfDay           Boolean       @default(false) @map("is_half_day")
  totalDays           Decimal       @map("total_days") @db.Decimal(5, 2)
  reason              String
  attachmentKey       String?       @map("attachment_key") @db.VarChar(500)
  status              RequestStatus @default(pending)
  currentApprovalStep Int           @default(1) @map("current_approval_step")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee         @relation(fields: [employeeId], references: [id])
  leaveType LeaveType        @relation(fields: [leaveTypeId], references: [id])
  workflow  ApprovalWorkflow @relation(fields: [workflowId], references: [id])

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// ───────────────────────────── Lembur (Fase 2) ─────────────────────────────

model OvertimeEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  employeeId          String          @map("employee_id") @db.Uuid
  workDate            DateTime        @map("work_date") @db.Date
  startTime           DateTime        @map("start_time") @db.Timestamptz(6)
  endTime             DateTime        @map("end_time") @db.Timestamptz(6)
  hours               Decimal         @db.Decimal(4, 2)
  dayType             OvertimeDayType @map("day_type")
  reason              String
  workflowId          String          @map("workflow_id") @db.Uuid
  currentApprovalStep Int             @default(1) @map("current_approval_step")
  status              RequestStatus   @default(pending)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee         @relation(fields: [employeeId], references: [id])
  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])

  @@index([employeeId, workDate])
  @@index([employeeId, status])
  @@map("overtime_entries")
}

// ───────────────────────────── Notifikasi In-App (Fase 2) ─────────────────────────────

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ───────────────────────────── Rate Regulasi Payroll (Fase 3) ─────────────────────────────

model TerRate {
  id           String   @id @default(uuid()) @db.Uuid
  kategori     String   @db.Char(1) // A, B, C
  batasBawah   BigInt   @map("batas_bawah")
  batasAtas    BigInt?  @map("batas_atas")
  tarif        Decimal  @db.Decimal(6, 5)
  berlakuSejak DateTime @map("berlaku_sejak") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([berlakuSejak, kategori, batasBawah])
  @@map("ter_rates")
}

model PtkpRate {
  id            String   @id @default(uuid()) @db.Uuid
  status        String   @db.VarChar(5) // TK/0 .. K/3
  amountPerYear Decimal  @map("amount_per_year") @db.Decimal(15, 0)
  terCategory   String   @map("ter_category") @db.Char(1) // A, B, C
  berlakuSejak  DateTime @map("berlaku_sejak") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([status, berlakuSejak])
  @@map("ptkp_rates")
}

model Pph21ProgressiveRate {
  id           String   @id @default(uuid()) @db.Uuid
  batasBawah   BigInt   @map("batas_bawah")
  batasAtas    BigInt?  @map("batas_atas")
  tarif        Decimal  @db.Decimal(6, 5)
  berlakuSejak DateTime @map("berlaku_sejak") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([berlakuSejak, batasBawah])
  @@map("pph21_progressive_rates")
}

model BpjsRate {
  id                    String      @id @default(uuid()) @db.Uuid
  program               BpjsProgram
  riskClass             String?     @map("risk_class") @db.VarChar(5) // khusus JKK (I..V)
  companyPercentage     Decimal     @map("company_percentage") @db.Decimal(6, 5)
  employeePercentage    Decimal     @map("employee_percentage") @db.Decimal(6, 5)
  extraFamilyPercentage Decimal?    @map("extra_family_percentage") @db.Decimal(6, 5)
  wageCap               BigInt?     @map("wage_cap")
  berlakuSejak          DateTime    @map("berlaku_sejak") @db.Date
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // UNIQUE (program, risk_class, berlaku_sejak) NULLS NOT DISTINCT dibuat di migrasi SQL
  @@index([berlakuSejak, program])
  @@map("bpjs_rates")
}

model OvertimeRule {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String?         @map("company_id") @db.Uuid // null = aturan default PP 35/2021
  workPattern  WorkPattern     @map("work_pattern")
  dayType      OvertimeDayType @map("day_type")
  hourFrom     Int             @map("hour_from")
  hourTo       Int?            @map("hour_to")
  multiplier   Decimal         @db.Decimal(3, 2)
  berlakuSejak DateTime        @map("berlaku_sejak") @db.Date
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([berlakuSejak, workPattern, dayType])
  @@map("overtime_rules")
}

// ───────────────────────────── Payroll Runs & Slips (Fase 4) ─────────────────────────────

model PayrollPeriod {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  year             Int
  month            Int
  runType          PayrollRunType      @default(regular) @map("run_type")
  runSequence      Int                 @default(1) @map("run_sequence")
  attendanceStart  DateTime            @map("attendance_start") @db.Date
  attendanceEnd    DateTime            @map("attendance_end") @db.Date
  payDate          DateTime            @map("pay_date") @db.Date
  isFinalTaxPeriod Boolean             @default(false) @map("is_final_tax_period")
  status           PayrollPeriodStatus @default(draft)
  processedBy      String?             @map("processed_by") @db.Uuid
  approvedBy       String?             @map("approved_by") @db.Uuid
  rejectionNotes   String?             @map("rejection_notes")
  lockedAt         DateTime?           @map("locked_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id])
  details        PayrollDetail[]
  reimbursements Reimbursement[]

  @@unique([companyId, year, month, runType, runSequence])
  @@index([companyId, year, month])
  @@map("payroll_periods")
}

model PayrollDetail {
  id                         String      @id @default(uuid()) @db.Uuid
  payrollPeriodId            String      @map("payroll_period_id") @db.Uuid
  employeeId                 String      @map("employee_id") @db.Uuid
  baseSalaryEncrypted        String      @map("base_salary_encrypted")
  fixedAllowanceEncrypted    String      @map("fixed_allowance_encrypted")
  variableAllowanceEncrypted String      @map("variable_allowance_encrypted")
  overtimeAmountEncrypted    String      @map("overtime_amount_encrypted")
  irregularIncomeEncrypted   String      @map("irregular_income_encrypted")
  bpjsWageBase               Decimal     @map("bpjs_wage_base") @db.Decimal(15, 0)
  bpjsKesEmployee            Decimal     @map("bpjs_kes_employee") @db.Decimal(15, 0)
  bpjsKesCompany             Decimal     @map("bpjs_kes_company") @db.Decimal(15, 0)
  jhtEmployee                Decimal     @map("jht_employee") @db.Decimal(15, 0)
  jhtCompany                 Decimal     @map("jht_company") @db.Decimal(15, 0)
  jkkCompany                 Decimal     @map("jkk_company") @db.Decimal(15, 0)
  jkmCompany                 Decimal     @map("jkm_company") @db.Decimal(15, 0)
  jpEmployee                 Decimal     @map("jp_employee") @db.Decimal(15, 0)
  jpCompany                  Decimal     @map("jp_company") @db.Decimal(15, 0)
  pph21GrossEncrypted        String      @map("pph21_gross_encrypted")
  pph21Method                Pph21Method @map("pph21_method")
  pph21AmountEncrypted       String      @map("pph21_amount_encrypted")
  pph21RefundEncrypted       String      @map("pph21_refund_encrypted")
  isFinalTaxPeriod           Boolean     @default(false) @map("is_final_tax_period")
  otherDeductionsEncrypted   String      @map("other_deductions_encrypted")
  netSalaryEncrypted         String      @map("net_salary_encrypted")
  rateSnapshot               Json        @map("rate_snapshot")
  createdAt                  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  period     PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id])
  components PayrollComponent[]

  @@unique([payrollPeriodId, employeeId])
  @@map("payroll_details")
}

model PayrollComponent {
  id              String               @id @default(uuid()) @db.Uuid
  payrollDetailId String               @map("payroll_detail_id") @db.Uuid
  componentType   PayrollComponentKind @map("component_type")
  componentCode   String               @map("component_code") @db.VarChar(50)
  componentName   String               @map("component_name") @db.VarChar(100)
  amountEncrypted String               @map("amount_encrypted")
  referenceId     String?              @map("reference_id") @db.Uuid

  detail PayrollDetail @relation(fields: [payrollDetailId], references: [id], onDelete: Cascade)

  @@index([payrollDetailId])
  @@map("payroll_components")
}

model TaxYearSummary {
  id                  String   @id @default(uuid()) @db.Uuid
  employeeId          String   @map("employee_id") @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  year                Int
  ptkpStatus          String   @map("ptkp_status") @db.VarChar(5)
  monthsWorked        Int      @default(0) @map("months_worked")
  grossYtdEncrypted   String   @map("gross_ytd_encrypted")
  jhtEmployeeYtd      Decimal  @default(0) @map("jht_employee_ytd") @db.Decimal(15, 0)
  jpEmployeeYtd       Decimal  @default(0) @map("jp_employee_ytd") @db.Decimal(15, 0)
  pph21YtdEncrypted   String   @map("pph21_ytd_encrypted")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, companyId, year])
  @@map("tax_year_summaries")
}

// ───────────────────────────── Reimbursement (Fase 5) ─────────────────────────────

model Reimbursement {
  id                  String                @id @default(uuid()) @db.Uuid
  companyId           String                @map("company_id") @db.Uuid
  employeeId          String                @map("employee_id") @db.Uuid
  category            ReimbursementCategory
  title               String                @db.VarChar(150)
  expenseDate         DateTime              @map("expense_date") @db.Date
  amount              Decimal               @db.Decimal(15, 0)
  description         String
  receiptRef          String?               @map("receipt_ref") @db.VarChar(200)
  status              RequestStatus         @default(pending)
  workflowId          String                @map("workflow_id") @db.Uuid
  currentApprovalStep Int                   @default(1) @map("current_approval_step")
  paidPayrollPeriodId String?               @map("paid_payroll_period_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  company           Company          @relation(fields: [companyId], references: [id])
  employee          Employee         @relation(fields: [employeeId], references: [id])
  workflow          ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  paidPayrollPeriod PayrollPeriod?   @relation(fields: [paidPayrollPeriodId], references: [id])

  @@index([companyId, status])
  @@index([employeeId, createdAt(sort: Desc)])
  @@index([companyId, status, paidPayrollPeriodId])
  @@map("reimbursements")
}
